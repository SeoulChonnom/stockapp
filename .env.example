# Stockapp local environment template.
# Copy this file to .env and fill values locally. Never commit real secrets.

# Runtime
STOCKAPP_APP_ENV=development
STOCKAPP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Use a SQLAlchemy PostgreSQL URL for the FastAPI app.
STOCKAPP_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
STOCKAPP_DATABASE_SCHEMA=stock
STOCKAPP_DATABASE_POOL_SIZE=5
STOCKAPP_DATABASE_MAX_OVERFLOW=10
STOCKAPP_DATABASE_POOL_TIMEOUT_SECONDS=30

# Durable batch worker
STOCKAPP_BATCH_WORKER_POLL_INTERVAL_SECONDS=5
STOCKAPP_BATCH_WORKER_HEARTBEAT_SECONDS=30
STOCKAPP_BATCH_WORKER_LEASE_SECONDS=120
STOCKAPP_BATCH_WORKER_MAX_ATTEMPTS=3
STOCKAPP_BATCH_WORKER_RETRY_DELAY_SECONDS=30
# Persist and enrich at most this many deterministic cluster candidates per market.
STOCKAPP_BATCH_MAX_CLUSTERS_PER_MARKET=12
# Recover durable PENDING/expired jobs once when the API process starts.
STOCKAPP_BATCH_STARTUP_RECOVERY_ENABLED=true

# JWT
# Production startup requires a base64url encoded secret that decodes to at least 32 bytes.
STOCKAPP_JWT_SECRET=<base64url-encoded-secret>
STOCKAPP_JWT_ALGORITHM=HS512
STOCKAPP_JWT_ISSUER=slcnapp
STOCKAPP_JWT_ACCESS_AUDIENCES=slcn-platform

# Naver News API
STOCKAPP_NAVER_CLIENT_ID=<naver-client-id>
STOCKAPP_NAVER_CLIENT_SECRET=<naver-client-secret>
STOCKAPP_NAVER_NEWS_BASE_URL=https://openapi.naver.com/v1/search/news.json
STOCKAPP_NAVER_NEWS_TIMEOUT_SECONDS=10

# Article crawling
STOCKAPP_ARTICLE_CRAWL_TIMEOUT_SECONDS=10
STOCKAPP_ARTICLE_CRAWL_USER_AGENT=stockapp-batch/0.1
STOCKAPP_ARTICLE_CRAWL_CONCURRENCY_LIMIT=4

# Market index provider
STOCKAPP_YFINANCE_TIMEOUT_SECONDS=10
STOCKAPP_MARKET_SESSION_DATA_GRACE_MINUTES=30

# LLM provider
STOCKAPP_LLM_PROVIDER=google-genai
STOCKAPP_LLM_MODEL=gemini-3.1-flash-lite
STOCKAPP_LLM_TEMPERATURE=0.2
STOCKAPP_LLM_MAX_RETRIES=2
STOCKAPP_LLM_TIMEOUT_SECONDS=30
STOCKAPP_LLM_CONCURRENCY_LIMIT=2
STOCKAPP_LLM_REQUESTS_PER_MINUTE=12
STOCKAPP_GEMINI_API_KEY=<gemini-api-key>
